{{page-title '@tsparticles/ember'}}

<h2 id='title'>@tsparticles/ember</h2>

<button
  type='button'
  {{on
    'click'
    (fn (mut this.isConfettiVisible) (if this.isConfettiVisible false true))
  }}
>
  {{if this.isConfettiVisible 'Hide' 'Show'}} confetti
</button>

<Particles
  class='fixed-size-particles'
  @options={{this.options}}
  @particlesInit={{this.loadFullOptions}}
  @particlesLoaded={{this.loadedCallback}}
/>

<Particles
  class='fixed-size-stars'
  @options={{hash preset='stars' fullScreen=(hash enable=false)}}
  @particlesInit={{this.loadStarsPreset}}
/>

{{#if this.isConfettiVisible}}
  <Particles
    @options={{this.confetti}}
    @particlesInit={{this.loadFullOptions}}
  />
{{/if}}